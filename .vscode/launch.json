{
    "version": "0.2.0",
    "configurations": [
        {
            // Same as: uv run --env-file .env example/api_fastapi.py, with breakpoints
            "name": "example: api_fastapi",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/example/api_fastapi.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
