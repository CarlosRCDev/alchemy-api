{
    "database": {
        "type": "sqlite",
        "path": "example/db/example.db",
        "show_query": true,
        "log": {
            "path": "example/logdb/example.log",
            "level_log": "DEBUG",
            "backup_count": 10
        }
    },
    "permissions": {
        "admin": {
            "roles": [
                "*"
            ],
            "tables": [
                "*"
            ]
        },
        "editor": {
            "roles": [
                "tables",
                "schema",
                "select",
                "insert",
                "update",
                "delete",
                "log_read"
            ],
            "tables": [
                "users"
            ]
        },
        "reader": {
            "roles": [
                "tables",
                "schema",
                "select"
            ],
            "tables": [
                "users"
            ]
        }
    }
}
