{
    "database": {
        "type": "sqlite",
        "path": "example/db/example.db",
        "show_query": true,
        "log": {
            "path": "example/logdb/example.log",
            "level_log": "DEBUG",
            "backup_count": 10
        }
    },
    "roles": {
        "admin": [
            "*"
        ],
        "editor": [
            "tables",
            "schema",
            "select",
            "insert",
            "update",
            "delete",
            "log_read"
        ],
        "reader": [
            "tables",
            "schema",
            "select"
        ]
    }
}
