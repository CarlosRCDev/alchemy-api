{
    "database": {
        "type": "mariadb",
        "user": "test",
        "password": "test",
        "server": "localhost",
        "port": 3306,
        "db": "test",
        "show_query": false,
        "log": {
            "path": "tests/logdb/log_mariadb.log",
            "level_log": "INFO",
            "backup_count": 10
        }
    },
    "permissions": {
        "admin": {
            "roles": [
                "*"
            ],
            "tables": [
                "*"
            ]
        },
        "editor": {
            "roles": [
                "tables",
                "schema",
                "select",
                "insert",
                "update",
                "delete",
                "log_read"
            ],
            "tables": [
                "users"
            ]
        },
        "reader": {
            "roles": [
                "tables",
                "schema",
                "select"
            ],
            "tables": [
                "users"
            ]
        }
    }
}
