{
    "database": {
        "type": "sqlite",
        "path": "tests/db/test_sqlite.db",
        "show_query": false,
        "modifiers": {
            "lower_table": true,
            "lower_cols": true,
            "ret_upper_table": true,
            "ret_upper_cols": true
        },
        "log": {
            "path": "tests/logdb/log_sqlite.log",
            "level_log": "INFO",
            "backup_count": 10
        }
    },
    "permissions": {
        "admin": {
            "roles": [
                "*"
            ],
            "tables": [
                "*"
            ]
        },
        "editor": {
            "roles": [
                "tables",
                "schema",
                "select",
                "insert",
                "update",
                "delete",
                "log_read"
            ],
            "tables": [
                "users"
            ]
        },
        "reader": {
            "roles": [
                "tables",
                "schema",
                "select"
            ],
            "tables": [
                "users"
            ]
        }
    }
}
