{
    "database": {
        "type": "oracle",
        "user": "test",
        "password": "test",
        "server": "localhost",
        "port": 1521,
        "service_name": "FREEPDB1",
        "show_query": false,
        "modifiers": {
            "lower_table": true,
            "lower_cols": true,
            "ret_upper_table": true,
            "ret_upper_cols": true
        },
        "log": {
            "path": "tests/logdb/log_oracle.log",
            "level_log": "INFO",
            "backup_count": 10
        }
    },
    "permissions": {
        "admin": {
            "roles": [
                "*"
            ],
            "tables": [
                "*"
            ]
        },
        "editor": {
            "roles": [
                "tables",
                "schema",
                "select",
                "insert",
                "update",
                "delete",
                "log_read"
            ],
            "tables": [
                "users"
            ]
        },
        "reader": {
            "roles": [
                "tables",
                "schema",
                "select"
            ],
            "tables": [
                "users"
            ]
        }
    }
}
