{
    "database": {
        "type": "sqlite",
        "path": "/app/db/data.db",
        "log": {
            "path": "/app/logdb/mcp.log",
            "level_log": "INFO",
            "backup_count": 10
        }
    },
    "permissions": {
        "admin": {
            "roles": ["*"],
            "tables": ["*"]
        },
        "reader": {
            "roles": ["tables", "schema", "select"],
            "tables": ["*"]
        }
    }
}
